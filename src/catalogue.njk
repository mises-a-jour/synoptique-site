---
layout: base.njk
title: Catalogue
description: "Le catalogue complet des Éditions Synoptique et des Presses Philosophiques — par auteur, titre, genre, collection et maison."
---
{% from "macros.njk" import bookcard %}
{% set livres = collections.livres %}
{% set auteurs = livres | pluck("data.auteurNom") | distinct | parPatronyme(collections.auteurs) %}
{% set genres = livres | pluck("data.genre") | distinct %}
{% set collectionsListe = livres | pluck("data.collection") | distinct %}

<div class="page-lede wrap" id="recherche">
  <h1>{{ pages.catalogue.titre }}</h1>
  <p class="hero__lede">{{ livres.length }} {{ pages.catalogue.intro_suite }}</p>
</div>

<section class="wrap">
  <div class="facets">
    <div class="facet-row">
      <span class="label">Recherche</span>
      <input type="search" id="q" placeholder="Un titre…"
             style="font-family:var(--serif);font-size:1rem;padding:.4em .8em;border:1px solid var(--rule-2);border-radius:999px;background:var(--paper-2);min-width:14rem">
    </div>
    <div class="facet-row" data-facet="auteur-nom">
      <span class="label">Auteur</span>
      <button class="chip" data-val="" aria-pressed="true">Tous</button>
      {% for a in auteurs %}<button class="chip" data-val="{{ a }}">{{ a }}</button>{% endfor %}
    </div>
    <div class="facet-row" data-facet="genre">
      <span class="label">Genre</span>
      <button class="chip" data-val="" aria-pressed="true">Tous</button>
      {% for g in genres %}<button class="chip" data-val="{{ g }}">{{ g }}</button>{% endfor %}
    </div>
    <div class="facet-row" data-facet="collection">
      <span class="label">Collection</span>
      <button class="chip" data-val="" aria-pressed="true">Toutes</button>
      {% for c in collectionsListe %}<button class="chip" data-val="{{ c }}">{{ c }}</button>{% endfor %}
    </div>
    <div class="facet-row" data-facet="maison">
      <span class="label">Maison</span>
      <button class="chip" data-val="" aria-pressed="true">Toutes</button>
      <button class="chip" data-val="synoptique">Éditions Synoptique</button>
      <button class="chip" data-val="presses">Les Presses Philosophiques</button>
    </div>
    <div class="facet-row">
      <span class="label">Parcourir</span>
      <a class="chip" href="/auteurs/">Les auteurs</a>
      <a class="chip" href="/poesie/">Poésie</a>
      <a class="chip" href="/essais/">Essais</a>
      <a class="chip" href="/aphorismes/">Aphorismes</a>
      <a class="chip" href="/philosophie/">Philosophie</a>
      <a class="chip" href="/collections/marcel-de-corte/">Collection Marcel De Corte</a>
      <a class="chip" href="/presses-philosophiques/">Les Presses Philosophiques</a>
    </div>
  </div>

  <div class="book-grid" id="grid">
    {% for item in livres %}
      <article class="book" data-maison="{{ item.data.maison }}" data-genre="{{ item.data.genre }}"
               data-auteur-nom="{{ item.data.auteurNom }}" data-collection="{{ item.data.collection or '' }}"
               data-titre="{{ item.data.titre | lower }}">
        <a href="{{ item.url }}" aria-label="{{ item.data.titre }}">
          {% if item.data.cover %}
            <span class="book__cover"><img src="/assets/covers/{{ item.data.cover }}" alt="Couverture de {{ item.data.titre }}" loading="lazy"></span>
          {% else %}
            <span class="book__cover"><span class="cover-ph {% if item.data.maison == 'presses' %}cover-ph--bleu{% endif %}">
              <span class="cover-ph__top">{{ item.data.auteurNom }}</span>
              <span class="cover-ph__title">{{ item.data.titre }}</span>
              <span class="cover-ph__house">{% if item.data.maison == 'presses' %}Les Presses Philosophiques{% else %}Synoptique{% endif %}</span>
            </span></span>
          {% endif %}
        </a>
        <div class="book__meta">
          <h3 class="book__title"><a href="{{ item.url }}">{{ item.data.titre }}</a></h3>
          <div class="book__author">{{ item.data.auteurNom }}</div>
          <div class="book__line">
            <span class="tag {% if item.data.maison == 'presses' %}tag--bleu{% endif %}">{{ item.data.genre }}</span>
            <span class="book__price">{{ item.data.prixCAD }}&nbsp;$</span>
          </div>
          {% if item.data.maison == 'presses' %}<div class="book__house">Les Presses Philosophiques</div>{% endif %}
        </div>
      </article>
    {% endfor %}
  </div>
  <p id="empty" class="placeholder-note" style="display:none">Aucun titre ne correspond à ces critères.</p>
</section>

<script>
(function(){
  var state={maison:"",genre:"",'auteur-nom':"",collection:"",q:""};
  var grid=document.getElementById('grid'),
      cards=[].slice.call(grid.querySelectorAll('.book')),
      empty=document.getElementById('empty'),
      qbox=document.getElementById('q');

  function apply(){
    var shown=0;
    cards.forEach(function(c){
      var ok=true;
      ['maison','genre','auteur-nom','collection'].forEach(function(f){
        if(state[f] && c.getAttribute('data-'+f)!==state[f]) ok=false;
      });
      if(state.q && c.getAttribute('data-titre').indexOf(state.q)===-1) ok=false;
      c.style.display=ok?'':'none';
      if(ok) shown++;
    });
    empty.style.display=shown?'none':'';
  }
  document.querySelectorAll('.facet-row[data-facet]').forEach(function(row){
    var facet=row.getAttribute('data-facet');
    row.querySelectorAll('.chip').forEach(function(chip){
      chip.addEventListener('click',function(){
        state[facet]=chip.getAttribute('data-val');
        row.querySelectorAll('.chip').forEach(function(x){x.setAttribute('aria-pressed','false')});
        chip.setAttribute('aria-pressed','true');
        apply();
      });
    });
  });
  qbox.addEventListener('input',function(){ state.q=qbox.value.toLowerCase().trim(); apply(); });
})();
</script>
