<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} — {{ site.nom }}{% else %}{{ site.nom }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.nom }}">
  <meta property="og:title" content="{% if title %}{{ title }}{% else %}{{ site.nom }}{% endif %}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:locale" content="fr_CA">

  <!-- Polices -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/assets/css/synoptique.css">
</head>
<body>

<header class="masthead">
  <div class="wrap masthead__bar">
    <a class="brand" href="/" aria-label="Accueil — {{ site.nom }}">
      {% include "emblem.njk" %}
      <span>
        <span class="brand__name">Synoptique</span>
        <span class="brand__tag">{{ site.tagline }}</span>
      </span>
    </a>

    <button class="menu-toggle" aria-label="Menu" aria-expanded="false" id="menuBtn">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
    </button>

    <nav class="nav" id="nav" aria-label="Navigation principale">
      <ul>
        {% for item in site.nav %}
        <li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.titre }}</a></li>
        {% endfor %}
        <li><a class="nav__icon" href="/catalogue/#recherche" aria-label="Recherche">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke-width="1.6"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.5-4.5" stroke-linecap="round"/></svg>
        </a></li>
        <li><a class="nav__icon" href="/panier/" aria-label="Panier">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke-width="1.6"><path d="M6 7h13l-1.4 9.5a2 2 0 0 1-2 1.7H9.4a2 2 0 0 1-2-1.7L6 7zM6 7L5 3H2" stroke-linejoin="round" stroke-linecap="round"/></svg>
        </a></li>
      </ul>
    </nav>
  </div>
</header>

<main>
  {{ content | safe }}
</main>

<footer class="foot">
  <div class="wrap foot__top">
    <div class="foot__brand">
      {% include "emblem.njk" %}
      <div class="name">Éditions Synoptique</div>
      <p>{{ site.description }}</p>
    </div>
    <div>
      <h4>Parcourir</h4>
      <ul>
        {% for item in site.nav %}
        <li><a href="{{ item.url }}">{{ item.titre }}</a></li>
        {% endfor %}
        <li><a href="/presses-philosophiques/">Les Presses Philosophiques</a></li>
      </ul>
    </div>
    <div>
      <h4>Informations</h4>
      <ul>
        {% for item in site.legal %}
        <li><a href="{{ item.url }}">{{ item.titre }}</a></li>
        {% endfor %}
        <li><a href="/nous-ecrire/">Nous écrire</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap foot__bottom">
    <span>© {{ site.annee }} {{ site.nom }}</span>
    <nav>
      {% for item in site.nav %}<a href="{{ item.url }}">{{ item.titre }}</a>{% endfor %}
    </nav>
  </div>
</footer>

<script>
  (function () {
    var btn = document.getElementById('menuBtn'),
        nav = document.getElementById('nav');
    if (btn && nav) {
      btn.addEventListener('click', function () {
        var open = nav.classList.toggle('open');
        btn.setAttribute('aria-expanded', open);
      });
    }
    // décalage de l'animation des fiches livre
    document.querySelectorAll('.book').forEach(function (el, i) {
      el.style.animationDelay = (i % 12) * 55 + 'ms';
    });
  })();
</script>
</body>
</html>
