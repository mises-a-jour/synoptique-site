---
layout: base.njk
title: Agenda
description: "Lancements, signatures et salons des Éditions Synoptique."
---
{% set p = pages.agenda %}

<div class="page-lede wrap">
  <h1>{{ p.titre }}</h1>
  <p class="hero__lede">{{ p.intro }}</p>
</div>

<section class="wrap agenda">
  <h2 class="agenda__titre">{{ p.titre_avenir }}</h2>
  {% set avenir = evenements | evenementsAvenir %}
  {% if avenir.length > 0 %}
    <ul class="agenda-list">
      {% for ev in avenir %}
        <li class="agenda-item">
          <div class="agenda-item__date">{{ ev.dateLisible or ev.date }}{% if ev.heure %} · {{ ev.heure }}{% endif %}</div>
          <div class="agenda-item__corps">
            <div class="label">{{ ev.type }}</div>
            <h3>{{ ev.titre }}</h3>
            {% if ev.auteur %}<p class="agenda-item__auteur">{{ ev.auteur }}</p>{% endif %}
            {% if ev.lieu %}<p class="agenda-item__lieu">{{ ev.lieu }}{% if ev.adresse %}, {{ ev.adresse }}{% endif %}</p>{% endif %}
            {% if ev.description %}<p>{{ ev.description }}</p>{% endif %}
            {% if ev.note %}<p class="agenda-item__note">{{ ev.note }}</p>{% endif %}
          </div>
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p class="agenda__vide">{{ p.vide_avenir }}</p>
  {% endif %}

  <h2 class="agenda__titre agenda__titre--passes">{{ p.titre_passes }}</h2>
  {% set passes = evenements | evenementsPasses %}
  {% if passes.length > 0 %}
    <ul class="agenda-list agenda-list--passes">
      {% for ev in passes %}
        <li class="agenda-item agenda-item--passe">
          <div class="agenda-item__date">{{ ev.dateLisible or ev.date }}{% if ev.heure %} · {{ ev.heure }}{% endif %}</div>
          <div class="agenda-item__corps">
            <div class="label">{{ ev.type }}</div>
            <h3>{{ ev.titre }}</h3>
            {% if ev.auteur %}<p class="agenda-item__auteur">{{ ev.auteur }}</p>{% endif %}
            {% if ev.lieu %}<p class="agenda-item__lieu">{{ ev.lieu }}{% if ev.adresse %}, {{ ev.adresse }}{% endif %}</p>{% endif %}
            {% if ev.description %}<p>{{ ev.description }}</p>{% endif %}
            {% if ev.note %}<p class="agenda-item__note">{{ ev.note }}</p>{% endif %}
          </div>
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p class="agenda__vide">{{ p.vide_passes }}</p>
  {% endif %}
</section>
