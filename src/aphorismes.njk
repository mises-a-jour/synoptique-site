---
layout: base.njk
title: Aphorismes
description: "Les titres en aphorismes aux Éditions Synoptique et aux Presses Philosophiques."
permalink: /aphorismes/
---
{% from "macros.njk" import bookcard %}
{% set titres = collections.livres | parGenre("aphorismes") %}

<div class="page-lede wrap">
  <div class="label">Genre</div>
  <h1>Aphorismes</h1>
  <p class="hero__lede">{{ pages.genres.aphorismes_intro }}</p>
</div>

<section class="wrap">
  <div class="section-head">
    <h2>{{ titres.length }} titre{{ "s" if titres.length > 1 }}</h2>
    <a class="more" href="/catalogue/">Tout le catalogue →</a>
  </div>
  {% if titres.length > 0 %}
    <div class="book-grid">
      {% for item in titres %}{{ bookcard(item) }}{% endfor %}
    </div>
  {% else %}
    <p class="prose">Aucun titre dans cette catégorie pour le moment.</p>
  {% endif %}
</section>
