---
layout: base.njk
title: false
description: "Éditions Synoptique — maison littéraire et philosophique. Essais, aphorismes, poésie et fiction, dans des éditions papier soignées."
---
{% from "macros.njk" import bookcard %}
{% set nouveautes = collections.nouveautes %}
{% set p = pages.accueil %}

<section class="hero">
  <div class="wrap">
    <h1>{{ p.titre_ligne1 }} <em>{{ p.titre_ligne2 }}</em></h1>
    <p class="hero__lede"><span class="drop">{{ p.intro_lettrine }}</span>{{ p.intro }}</p>
    <a class="btn btn--ghost" href="/la-maison/">{{ p.bouton_texte }}</a>
  </div>
  <div class="hero__mark">{% include "emblem.njk" %}</div>
</section>


<section class="wrap" id="nouveautes">
  <div class="section-head">
    <h2>{{ p.titre_nouveautes }}</h2>
    <a class="more" href="/nouveautes/">{{ p.lien_nouveautes }}</a>
  </div>
  <div class="book-grid book-grid--feature">
    {% for item in nouveautes %}{{ bookcard(item) }}{% endfor %}
  </div>
</section>

<section class="wrap">
  <div class="section-head">
    <h2>{{ p.titre_catalogue }}</h2>
    <a class="more" href="/catalogue/">{{ p.lien_catalogue }}</a>
  </div>
  <div class="book-grid">
    {% for item in collections.livres %}
      {% if not item.data.nouveaute %}{{ bookcard(item) }}{% endif %}
    {% endfor %}
  </div>
</section>
