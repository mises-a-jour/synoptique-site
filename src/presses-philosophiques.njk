---
layout: base.njk
title: Les Presses Philosophiques
description: "Les Presses Philosophiques — maison affiliée aux Éditions Synoptique, vouée à la philosophie et aux éditions savantes."
permalink: /presses-philosophiques/
---
{% from "macros.njk" import bookcard %}
{% set titres = collections.livres | parMaison("presses") %}
{% set auteursPresses = titres | pluck("data.auteurNom") | distinct | parPatronyme(collections.auteurs) %}

<div class="house-hd wrap">
  <div class="label">Maison affiliée</div>
  <h1 style="font-size:clamp(2.2rem,5vw,3.4rem);font-weight:500;margin:.2rem 0 0">Les Presses Philosophiques</h1>
  <p class="hero__lede" style="margin-top:.8rem">La maison affiliée des Éditions Synoptique, vouée à la poésie, à la philosophie et aux éditions savantes.</p>
</div>

<section class="wrap">
  <div class="section-head"><h2>Au catalogue des Presses</h2>
    <span class="label">{{ titres.length }} titres</span></div>
  <div class="book-grid">
    {% for item in titres %}{{ bookcard(item) }}{% endfor %}
  </div>
</section>

<section class="wrap">
  <div class="section-head"><h2>Auteurs des Presses</h2>
    <a class="more" href="/auteurs/">Tous les auteurs →</a></div>
  <p class="prose" style="padding-top:0">
    {% for nom in auteursPresses %}{{ nom }}{% if not loop.last %} · {% endif %}{% endfor %}
  </p>
</section>
