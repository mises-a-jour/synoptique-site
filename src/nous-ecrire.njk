---
layout: base.njk
title: Nous écrire
description: "Contacter les Éditions Synoptique : manuscrits, presse, libraires, demandes générales."
---
{% set p = pages.nous_ecrire %}

<div class="page-lede wrap">
  <h1>{{ p.titre }}</h1>
  <p class="hero__lede">{{ p.intro }}</p>
</div>

<section class="wrap">
  <div class="contact-grid">

    {# ─── Colonne gauche : formulaire (désactivé pour l'instant) ─── #}
    <div>
      <div class="label" style="margin-bottom:.8rem">{{ p.formulaire_label }}</div>
      <p style="color:var(--ink-soft);margin:0 0 1.4rem">{{ p.formulaire_note }}</p>
      <label class="field"><span>Nom</span>
        <input type="text" name="nom" autocomplete="name" disabled></label>
      <label class="field"><span>Courriel</span>
        <input type="email" name="courriel" autocomplete="email" disabled></label>
      <label class="field"><span>Objet</span>
        <select name="objet" disabled>
          <option>Manuscrit</option>
          <option>Demande de presse</option>
          <option>Demande libraire</option>
          <option>Question générale</option>
        </select></label>
      <label class="field"><span>Message</span>
        <textarea name="message" rows="6" disabled></textarea></label>
      <button class="btn" type="button" disabled>Envoyer</button>
      <span class="placeholder-note" style="margin-left:1rem">{{ p.formulaire_placeholder }}</span>
    </div>

    {# ─── Colonne droite : coordonnées et voies de correspondance ─── #}
    <div class="coords">
      <div>
        <span class="label">{{ p.courriel_label }}</span>
        <p style="margin:0"><a href="mailto:{{ p.courriel_adresse }}">{{ p.courriel_adresse }}</a></p>
      </div>
    </div>
  </div>
</section>

